# Organization 멤버 초대 권한(admin:org)을 가진 GitHub Personal Access Token
ORG_ADMIN_TOKEN=ghp_yourPersonalAccessTokenHere

# 대상 GitHub Organization 이름
ORG_NAME=Soongsil-Developers

# 실제 초대를 보내지 않고 테스트할 경우 true로 설정
DRY_RUN=true

# (선택 사항) 추가 매칭 키워드 (쉼표 구분)
# TARGET_KEYWORDS=soongsil,soogsil,숭실

# (선택 사항) 축약어 키워드 (단어 경계 일치, 쉼표 구분)
# TARGET_ACRONYMS=ssu
